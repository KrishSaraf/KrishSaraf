    <style>
        :root {
            --primary: #2c3e50;
            --secondary: #34495e;
            --accent: #3498db;
            --light: #ecf0f1;
            --text: #2c3e50;
            --subtle: #7f8c8d;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            color: var(--text);
            background-color: var(--light);
            line-height: 1.6;
        }
        
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        header {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 60px 0 40px;
            text-align: center;
        }
        
        header h1 {
            font-size: 2.8rem;
            margin-bottom: 15px;
            font-weight: 700;
        }
        
        header h2 {
            font-size: 1.5rem;
            font-weight: 400;
            margin-bottom: 10px;
            opacity: 0.9;
        }
        
        .profile-container {
            display: flex;
            flex-direction: column;
            gap: 40px;
            margin: 40px 0;
        }
        
        .section {
            background: white;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            padding: 30px;
            margin-bottom: 30px;
        }
        
        .section-title {
            font-size: 1.8rem;
            color: var(--primary);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .section-title span {
            font-size: 1.8rem;
        }
        
        .highlight {
            background: #f8f9fa;
            padding: 15px;
            border-left: 4px solid var(--accent);
            margin: 15px 0;
            border-radius: 0 4px 4px 0;
        }
        
        .stats {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin: 20px 0;
        }
        
        .stat-item {
            flex: 1;
            min-width: 210px;
            background: #f8f9fa;
            padding: 15px;
            border-radius: 6px;
            border-bottom: 3px solid var(--accent);
        }
        
        .stat-item h3 {
            font-size: 1.3rem;
            margin-bottom: 8px;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .stat-item p {
            font-size: 1rem;
            color: var(--subtle);
        }
        
        .skills {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 15px 0;
        }
        
        .skill-category {
            margin-bottom: 25px;
        }
        
        .skill-category h3 {
            margin-bottom: 10px;
            color: var(--primary);
            font-size: 1.2rem;
            border-bottom: 1px solid #eee;
            padding-bottom: 5px;
        }
        
        .skill-tag {
            background: #f1f1f1;
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 0.9rem;
            color: var(--secondary);
            display: inline-block;
        }
        
        .experience-item {
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 1px solid #eee;
        }
        
        .experience-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }
        
        .experience-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 5px;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .experience-company {
            font-size: 1rem;
            color: var(--accent);
            margin-bottom: 10px;
        }
        
        .achievements {
            list-style: none;
        }
        
        .achievements li {
            margin-bottom: 10px;
            position: relative;
            padding-left: 25px;
        }
        
        .achievements li:before {
            content: "•";
            color: var(--accent);
            font-weight: bold;
            font-size: 1.2rem;
            position: absolute;
            left: 0;
        }
        
        .contact {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 20px;
        }
        
        .contact-item {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--primary);
            padding: 10px;
            border-radius: 4px;
            transition: background 0.3s;
        }
        
        .contact-item:hover {
            background: #f1f1f1;
        }
        
        .project {
            margin-bottom: 25px;
            padding-bottom: 25px;
            border-bottom: 1px solid #eee;
        }
        
        .project:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }
        
        .project-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 10px;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .project-description {
            margin-bottom: 10px;
        }
        
        .project-skills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        
        .project-skill {
            background: #f8f9fa;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            color: var(--subtle);
        }
        
        .about-content {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .about-text {
            flex: 3;
        }
        
        .about-list {
            list-style: none;
        }
        
        .about-list li {
            margin-bottom: 12px;
            position: relative;
            padding-left: 25px;
            display: flex;
            align-items: center;
        }
        
        .about-list li span {
            margin-right: 10px;
        }
        
        footer {
            background: var(--primary);
            color: white;
            text-align: center;
            padding: 20px 0;
            margin-top: 40px;
        }
        
        @media (max-width: 768px) {
            .about-content {
                flex-direction: column;
            }
            
            .stats {
                flex-direction: column;
            }
            
            .stat-item {
                width: 100%;
            }
        }
    </style>
</head>
